<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:background="@drawable/card_dark"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <!-- Avatar Circle -->
    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/contact_circle"
        android:gravity="center"
        android:layout_marginEnd="14dp">

        <TextView
            android:id="@+id/tvContactInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Contact Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/tvContactName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="John Doe (Father)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvPrimaryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRIMARY"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/primary_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvContactPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+91 98765 43210"
            android:textSize="13sp"
            android:textColor="#8B949E" />

        <TextView
            android:id="@+id/tvContactRelationship"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Family"
            android:textSize="11sp"
            android:textColor="#484F58"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- SOS Notify / Actions -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnMessage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="💬"
            android:textSize="12sp"
            android:background="@drawable/contact_action_button"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnCall"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="📞"
            android:textSize="12sp"
            android:background="@drawable/contact_action_button"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="SOS NOTIFY"
            android:textSize="10sp"
            android:textColor="#E53935"
            android:textStyle="bold"
            android:background="@drawable/delete_button"
            android:paddingHorizontal="8dp" />

    </LinearLayout>

</LinearLayout>