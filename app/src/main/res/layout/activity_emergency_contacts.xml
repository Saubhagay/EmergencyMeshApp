<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#0D1117"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_emergency_mesh"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Emergency Mesh"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RELAYING"
            android:textSize="10sp"
            android:textColor="#58A6FF"
            android:background="@drawable/badge_blue"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MESH ACTIVE"
            android:textSize="10sp"
            android:textColor="#00C853"
            android:background="@drawable/badge_green"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Sub Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← "
            android:textSize="18sp"
            android:textColor="#8B949E" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Emergency Contacts"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAddContact"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="+"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/sos_button_circle"
            android:padding="0dp" />

    </LinearLayout>

    <!-- Import From Mobile Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnImportContacts"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📱  IMPORT FROM MOBILE"
            android:textSize="13sp"
            android:textColor="#8B949E"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:background="@drawable/card_dark" />

    </LinearLayout>

    <!-- Contacts Section Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PRIMARY CONTACTS"
        android:textSize="11sp"
        android:textColor="#8B949E"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp" />

    <!-- Contacts List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/llEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📞"
            android:textSize="48sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Contacts Added"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add emergency contacts to quickly send messages during disasters"
            android:textSize="13sp"
            android:textColor="#8B949E"
            android:gravity="center" />

    </LinearLayout>

    <!-- SOS Notify Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/card_dark"
        android:padding="14dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡"
            android:textSize="16sp"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Contacts marked with SOS Notify will be included in the header metadata of all SOS broadcasts you send."
            android:textSize="12sp"
            android:textColor="#8B949E"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>

    <!-- Broadcast Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnBroadcastToAll"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="📢  BROADCAST SOS TO ALL"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/emergency_button" />

    </LinearLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@drawable/bottom_nav_bg"
        android:paddingTop="8dp">

        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⊞" android:textSize="20sp" android:textColor="#8B949E" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HOME" android:textSize="10sp" android:textColor="#8B949E" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navInbox" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✉" android:textSize="20sp" android:textColor="#8B949E" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INBOX" android:textSize="10sp" android:textColor="#8B949E" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navMesh" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⛙" android:textSize="20sp" android:textColor="#8B949E" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MESH" android:textSize="10sp" android:textColor="#8B949E" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navOn" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X" android:textSize="20sp" android:textColor="#00C853" android:textStyle="bold" android:background="@drawable/badge_green" android:paddingHorizontal="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ON" android:textSize="10sp" android:textColor="#00C853" android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>