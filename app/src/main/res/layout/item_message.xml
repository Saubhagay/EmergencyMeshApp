<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_dark"
    android:padding="14dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp">

    <!-- Header: message type + timestamp + delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvMessageType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EMERGENCY ALERT"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#E53935"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="13:55"
            android:textSize="11sp"
            android:textColor="#8B949E"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDeleteMessage"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="✕"
            android:textSize="12sp"
            android:textColor="#8B949E"
            android:background="@drawable/button_dark"
            android:padding="0dp" />

    </LinearLayout>

    <!-- From / Hops Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvSenderInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="From: You (Device 01)"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecipientInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hops: 0"
            android:textSize="12sp"
            android:textColor="#8B949E"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Route Info (relay indicator) -->
    <TextView
        android:id="@+id/tvRouteInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📡 Relayed through mesh network"
        android:textSize="11sp"
        android:textColor="#FF9800"
        android:background="#1A1500"
        android:padding="6dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- Location Block (shown for location messages) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D2416"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 "
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOCATION SHARE"
                android:textSize="11sp"
                android:textColor="#00C853"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <!-- Message Content (includes coordinates for location messages) -->
        <TextView
            android:id="@+id/tvMessageContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emergency message content appears here."
            android:textSize="14sp"
            android:textColor="#CCCCCC"
            android:lineSpacingMultiplier="1.3"
            android:autoLink="web"
            android:linksClickable="true"
            android:textColorLink="#58A6FF" />

    </LinearLayout>

    <!-- Delivery Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDeliveryStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✓ Mesh Delivered"
            android:textSize="12sp"
            android:textColor="#3FB950" />

        <Button
            android:id="@+id/btnReply"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="REPLY"
            android:textSize="11sp"
            android:textColor="#58A6FF"
            android:textStyle="bold"
            android:background="@drawable/badge_blue"
            android:paddingHorizontal="12dp" />

    </LinearLayout>

</LinearLayout>